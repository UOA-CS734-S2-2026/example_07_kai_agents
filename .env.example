# Copy to .env and fill in. The key is issued to you individually: do not
# commit it, and do not share it.
#
# The UoA Agentic Gateway is OpenAI-compatible, so anything that speaks the
# OpenAI API speaks to it.
UOA_API_KEY=

# Optional. Both default to the course gateway and the model it serves, which
# is what every step is written against. Set them to point the same code at
# something else - another OpenAI-compatible gateway, or a local Ollama on
# http://localhost:11434/v1 - without editing llm.py or runtime.ts.
#
# If you do change the model, re-read the temperature note in llm.py: the
# advice there is about MiniMax-M3 specifically.
# UOA_BASE_URL=https://agent.elliottwen.info/v1
# UOA_MODEL=MiniMax-M3

# Optional. LangSmith traces every graph run, which is a good way to see what
# the agent actually did. Leave commented out and nothing is sent anywhere.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=kai-agents
