{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶️ Demo: Next Step",
      "type": "shell",
      "command": "${workspaceFolder}/demo.sh",
      "args": ["next"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-File", "${workspaceFolder}/demo.ps1", "next"]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "◀️ Demo: Previous Step",
      "type": "shell",
      "command": "${workspaceFolder}/demo.sh",
      "args": ["prev"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-File", "${workspaceFolder}/demo.ps1", "prev"]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "📚 Demo: List All Steps",
      "type": "shell",
      "command": "${workspaceFolder}/demo.sh",
      "args": ["list"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-File", "${workspaceFolder}/demo.ps1", "list"]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "🎯 Demo: Jump to Step",
      "type": "shell",
      "command": "${workspaceFolder}/demo.sh",
      "args": ["jump", "${input:stepTag}"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-File", "${workspaceFolder}/demo.ps1", "jump", "${input:stepTag}"]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "🏠 Demo: Go to step 1",
      "type": "shell",
      "command": "${workspaceFolder}/demo.sh",
      "args": ["jump", "01"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-File", "${workspaceFolder}/demo.ps1", "jump", "01"]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "🏁 Demo: Back to main",
      "type": "shell",
      "command": "${workspaceFolder}/demo.sh",
      "args": ["reset"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-File", "${workspaceFolder}/demo.ps1", "reset"]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "📱 Demo: Run app",
      "type": "shell",
      "command": "${workspaceFolder}/demo.sh",
      "args": ["run"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-File", "${workspaceFolder}/demo.ps1", "run"]
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "🔥 Demo: Refresh app",
      "type": "shell",
      "command": "${workspaceFolder}/demo.sh",
      "args": ["reload"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-File", "${workspaceFolder}/demo.ps1", "reload"]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "➕ Demo: Add step",
      "type": "shell",
      "command": "${workspaceFolder}/demo.sh",
      "args": ["add-step", "${input:stepSlug}", "${input:commitMessage}"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-File",
          "${workspaceFolder}/demo.ps1",
          "add-step",
          "${input:stepSlug}",
          "${input:commitMessage}"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "📝 Demo: Update all steps",
      "type": "shell",
      "command": "${workspaceFolder}/demo.sh",
      "args": ["update-all", "${input:commitMessage}"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-File",
          "${workspaceFolder}/demo.ps1",
          "update-all",
          "${input:commitMessage}"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "🗑️ Demo: Discard Changes",
      "type": "shell",
      "command": "${workspaceFolder}/demo.sh",
      "args": ["discard-changes"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-File", "${workspaceFolder}/demo.ps1", "discard-changes"]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "stepTag",
      "type": "promptString",
      "description": "Enter step number (e.g., 03, 10):",
      "default": "01"
    },
    {
      "id": "stepSlug",
      "type": "promptString",
      "description": "Step slug (lowercase, hyphens, e.g. favourite-button):"
    },
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Commit message for this step:"
    }
  ]
}
