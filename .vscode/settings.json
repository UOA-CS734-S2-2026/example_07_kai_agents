{
  // Hot reload when the demo step changes, for apps started with VS Code's
  // "Start Debugging". The Dart extension normally reloads on the editor's save
  // event, which a git checkout never fires; this switches it to a filesystem
  // watcher, which does see the checkout. Preview setting, workspace scoped.
  "dart.previewHotReloadOnSaveWatcher": true,
  "dart.flutterHotReloadOnSave": "all",

  // Task Buttons Extension - Demo Navigation Controls
  // Adds clickable buttons to the status bar for demo navigation
  "VsCodeTaskButtons.showCounter": false,
  "VsCodeTaskButtons.tasks": [
    {
      "label": "$(chevron-left) Prev step",
      "task": "◀️ Demo: Previous Step",
      "tooltip": "Go to previous demo step"
    },
    {
      "label": "$(chevron-right) Next step",
      "task": "▶️ Demo: Next Step",
      "tooltip": "Go to next demo step"
    },
    {
      "label": "$(list-ordered) List steps",
      "task": "📚 Demo: List All Steps",
      "tooltip": "Show all demo steps"
    },
    {
      "label": "$(go-to-file) Jump",
      "task": "🎯 Demo: Jump to Step",
      "tooltip": "Jump to a specific step"
    },
    {
      "label": "$(home) Step 1",
      "task": "🏠 Demo: Go to step 1",
      "tooltip": "Go to the first step in the demo"
    },
    {
      "label": "$(git-branch) main",
      "task": "🏁 Demo: Back to main",
      "tooltip": "Leave the demo and return to the main branch"
    }
  ]
}
